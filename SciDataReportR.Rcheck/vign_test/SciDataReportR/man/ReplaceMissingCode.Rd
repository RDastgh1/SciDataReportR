  status = c("Active", "Unknown", "Active", "Withdrawn", "Unknown", "Active")
)

# Several markers for one variable go in one cell
codebook <- data.frame(
  Variable    = c("age", "score", "status"),
  MissingCode = c("999, -7, -8", "-9", "Unknown")
