> nameEx("safe_merge")
> ### * safe_merge
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: safe_merge
> ### Title: Safely merge two data frames with relationship-aware validation
> ### Aliases: safe_merge
> 
> ### ** Examples
> 
> left <- data.frame(
+   record_id = c(1, 1, 2, 2),
+   visit_type = c(1, 2, 1, 2),
+   age = c(40, 40, 55, 55)
+ )
> 
> right <- data.frame(
+   record_id = c(1, 2),
+   imaging_score = c(0.4, 0.8)
+ )
> 
> m <- safe_merge(
+   df_before = left,
+   df_add = right,
+   by = "record_id",
+   name = "Example imaging merge",
+   expected_relationship = "many-to-one"
+ )
> 
> m$log
# A tibble: 1 × 27
