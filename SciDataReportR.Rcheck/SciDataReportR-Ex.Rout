> PlotAnovaRelationshipsMatrix(
+   Labelled,
+   CatVars = c("Diagnosis", "sex"),
+   ContVars = c("AXL", "Adiponectin", "Alpha_1_Antitrypsin"),
+   covariates = "age"
+ )$FDRCorrected$plot
