+   )
+ )
> 
> transitions <- SummarizeTransitions(
+   data = toy_df,
+   id_var = ParticipantID,
+   time_var = VisitOrder,
+   status_var = MetSBinary,
+   date_var = VisitDate,
+   x_axis_type = "time_from_baseline",
+   time_from_baseline_unit = "months"
+ )
